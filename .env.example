# 복사해서 .env 로 쓰세요. .env 는 깃에 올라가지 않아요.

# 카카오 지도 JavaScript 키 (developers.kakao.com → 앱 키 → JavaScript 키)
# 플랫폼 → Web → 사이트 도메인에 http://localhost:5173 등록 필요. 없으면 그림 지도로 동작
VITE_KAKAO_MAP_KEY=

# Claude API 키 (console.anthropic.com). 서버(api/analyze.js)에서만 읽는다 — VITE_ 접두사 없음 = 브라우저에 노출 안 됨
# 없으면 일기 분석이 키워드 기반 간단 분석으로 동작
ANTHROPIC_API_KEY=

# 한국관광공사 TourAPI 인증키(Decoding). npm run fetch-places 에서만 사용, 브라우저로 안 나감
TOUR_API_KEY=
